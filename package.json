{
  "name": "dataceam-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "content-lint": "node scripts/content-lint.mjs",
    "content-lint:test": "node scripts/content-lint.mjs --self-test",
    "links": "linkinator dist --recurse --skip '^https?://(?!(localhost|127\\.0\\.0\\.1|\\[::1\\]))'",
    "check": "astro check && astro build && npm run lint && npm run content-lint:test && npm run content-lint && npm run links",
    "check:full": "npm run check && lhci autorun && playwright test && gitleaks git --no-banner --redact && gitleaks git --staged --no-banner --redact"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.158.0"
  }
}
