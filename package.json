{
  "name": "dataceam-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-redirects.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "og": "node scripts/build-og.mjs",
    "repos:refresh": "node scripts/refresh-repos.mjs",
    "links:external": "node scripts/check-external-links.mjs",
    "pdfs": "node scripts/build-track-pdfs.mjs",
    "content-lint": "node scripts/content-lint.mjs",
    "content-lint:test": "node scripts/content-lint.mjs --self-test",
    "links": "linkinator dist --recurse --skip '^https?://(?!(localhost|127\\.0\\.0\\.1|\\[::1\\]))'",
    "guide:images": "node scripts/build-infographics.mjs",
    "guide:images:test": "node scripts/build-infographics.mjs --self-test",
    "guide:lint": "node scripts/guide-lint.mjs",
    "guide:lint:test": "node scripts/guide-lint.mjs --self-test",
    "guide:next": "node scripts/guide-queue.mjs",
    "guide:sources": "node scripts/guide-sources.mjs",
    "guide:publish": "node scripts/publish-guide.mjs",
    "guide:verify": "node scripts/verify-guide.mjs",
    "guide:test": "npm run guide:lint:test && node scripts/guide-queue.mjs --self-test && node scripts/guide-sources.mjs --self-test && node scripts/verify-guide.mjs --self-test && node scripts/publish-guide.mjs --self-test",
    "check": "astro check && npm run build && npm run lint && npm run content-lint:test && npm run content-lint && npm run guide:test && npm run guide:lint && npm run links",
    "check:full": "npm run check && lhci autorun && playwright test && gitleaks git --no-banner --redact && gitleaks git --staged --no-banner --redact"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.158.0"
  }
}
