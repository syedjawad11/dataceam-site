---
/**
 * The "statement" card: what Dataceam does, doesn't do, and how it's paid.
 * The last row is styled as the total.
 */
interface Props {
  title?: string;
  rows: [label: string, text: string][];
  foot: string;
  headingId: string;
}

const { title = 'Dataceam, plainly', rows, foot, headingId } = Astro.props;
---

<aside class="ledger" aria-labelledby={headingId}>
  <div class="ledger-title">
    <h2 id={headingId}>{title}</h2>
    <span>Referral statement</span>
  </div>
  <dl>
    {rows.map(([label, text], index) => (
      <div
        class:list={['ledger-row', { 'is-total': index === rows.length - 1 }]}
      >
        <dt>{label}</dt>
        <dd>{text}</dd>
      </div>
    ))}
  </dl>
  <p class="ledger-foot">{foot}</p>
</aside>
