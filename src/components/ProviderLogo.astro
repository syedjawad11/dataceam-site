---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  logo: string;
  provider: string;
}
const { logo, provider } = Astro.props;
// To add a mark: import its official SVG from ../assets/logos/<key>.svg
// and add { <key>: importedSvg } here. Keep the provider name as its label.
const registry: Readonly<Record<string, ImageMetadata>> = {};
const mark = registry[logo];
---

<span class="provider-logo">
  {mark && <Image src={mark} alt="" width={24} height={24} />}
  <span class:list={[!mark && 'badge learning-chip']}>{provider}</span>
</span>
