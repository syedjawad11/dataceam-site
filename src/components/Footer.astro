---
import { site } from '../config/site';
const year = new Date().getUTCFullYear();
const columns = [
  {
    title: 'Learn',
    links: [
      ['Guides', '/guides/'],
      ['Career tracks', '/tracks/'],
      ['Repos', '/repos/'],
    ],
  },
  {
    title: 'Work',
    links: [
      ['AI jobs', '/jobs/'],
      ['For companies', '/companies/'],
      ['Insights', '/insights/'],
    ],
  },
  {
    title: 'Dataceam',
    links: [
      ['FAQ', '/faq/'],
      ['Privacy', '/privacy/'],
      ['Referral disclosure', '/disclosure/'],
      [site.email, `mailto:${site.email}`],
    ],
  },
];
---

<footer class="site-footer">
  <div class="shell footer-content">
    <div>
      <a class="site-name" href="/" aria-label="Dataceam">
        dataceam<span class="wordmark-dot">.</span>
      </a>
      <p>Free AI learning, plainly explained.</p>
    </div>
    <div class="footer-columns">
      {columns.map(({ title, links }) => (
        <section aria-label={title}>
          <h2>{title}</h2>
          <ul class="footer-links">
            {links.map(([label, href]) => (
              <li>
                <a href={href}>{label}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <section aria-label="Follow">
        <h2>Follow</h2>
        <ul class="footer-links">
          <li>
            <a href={site.social.x} rel="me noopener">
              X
            </a>
          </li>
          <li>
            <a href={site.social.instagram} rel="me noopener">
              Instagram
            </a>
          </li>
          <li>Facebook (coming soon)</li>
        </ul>
      </section>
    </div>
    <p>© {year} Dataceam</p>
  </div>
</footer>
