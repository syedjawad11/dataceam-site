---
import { site } from '../config/site';

const year = new Date().getUTCFullYear();
const xUrl = `https://x.com/${site.xHandle.replace(/^@/, '')}`;
---

<footer class="site-footer">
  <div class="shell footer-content">
    <ul class="footer-links">
      <li>
        {site.email.startsWith('TODO_') ? (
          <span class="placeholder">[TO FILL: email]</span>
        ) : (
          <a href={`mailto:${site.email}`}>{site.email}</a>
        )}
      </li>
      <li>
        {site.xHandle.startsWith('TODO_') ? (
          <span class="placeholder">[TO FILL: X handle]</span>
        ) : (
          <a href={xUrl}>X</a>
        )}
      </li>
      <li>
        <a href="/faq/">FAQ</a>
      </li>
      <li>
        <a href="/insights/">Insights</a>
      </li>
      <li>
        <a href="/privacy/">Privacy</a>
      </li>
    </ul>
    <p>
      © {year} {site.name}
    </p>
  </div>
</footer>
