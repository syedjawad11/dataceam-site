---
import { site } from '../config/site';

const year = new Date().getUTCFullYear();
const xUrl = `https://x.com/${site.xHandle.replace(/^@/, '')}`;
---

<footer class="site-footer">
  <div class="shell footer-content">
    <section class="footer-disclosure" aria-labelledby="disclosure-heading">
      <h2 id="disclosure-heading">Independent referrer disclosure</h2>
      <p>
        Dataceam is a referrer only. This website is run independently by{' '}
        {site.personName} and is not affiliated with, endorsed by, sponsored by
        or acting on behalf of any AI-data buyer, AI-training platform or other
        company it refers to. I take part in open referral programmes and may
        earn a referral fee if you sign up, are hired or sign a deal through my
        links or introductions, at no cost to you.
      </p>
      <p>
        All applications, screening, hiring, pricing and payment decisions are
        made solely by the buyers and platforms, under their own terms. Nothing
        on this site promises an interview, a placement, a pay rate, a deal or a
        price. Pay and payout figures come from the buyers' and platforms' own
        public pages and are not a promise of earnings.
      </p>
    </section>
    <div class="footer-row">
      <ul class="footer-links">
        <li>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <a href={xUrl}>X</a>
        </li>
        <li>
          <a href="/privacy/">Privacy</a>
        </li>
      </ul>
      <p>
        © {year} {site.name}
      </p>
    </div>
  </div>
</footer>
