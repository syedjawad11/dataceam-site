---
import { site } from '../config/site';

interface Props {
  noteId: string;
  prominent?: boolean;
}

const { noteId, prominent = false } = Astro.props;
const pending = site.email.startsWith('TODO_');
---

<div class="home-action">
  <a
    class="button button-primary"
    href={pending ? '#contact' : `mailto:${site.email}`}
    aria-describedby={pending ? noteId : undefined}
  >
    Email me
  </a>
  {pending ? (
    <span
      id={noteId}
      class:list={['placeholder', { 'contact-email': prominent }]}
    >
      [TO FILL: jawad@dataceam.com]
    </span>
  ) : prominent ? (
    <a class="contact-email" href={`mailto:${site.email}`}>
      {site.email}
    </a>
  ) : null}
</div>
