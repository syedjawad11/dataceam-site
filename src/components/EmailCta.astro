---
import { site } from '../config/site';

interface Props {
  label: string;
  href?: string;
  noteId?: string;
  prominent?: boolean;
}

const { label, href, noteId, prominent = false } = Astro.props;
const pending = !site.email.trim() || site.email.startsWith('TODO_');
const showPending = pending && !href;
---

<div class="home-action">
  <a
    class="button button-primary"
    href={href ?? (pending ? '#contact' : `mailto:${site.email}`)}
    aria-describedby={showPending ? noteId : undefined}
  >
    {label}
  </a>
  {prominent ? (
    <p>
      Or write directly to{' '}
      {pending ? (
        <span id={noteId} class="placeholder contact-email">
          [TO FILL: contact email]
        </span>
      ) : (
        <a class="contact-email" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      )}
    </p>
  ) : showPending ? (
    <span id={noteId} class="placeholder">
      [TO FILL: contact email]
    </span>
  ) : null}
</div>
