---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
import '../styles/global.css';

type Props = SeoProps & {
  page?: string;
  /** Set false to keep analytics off a page (the résumé matcher). */
  analytics?: boolean;
};

const { page, analytics = true, ...seoProps } = Astro.props;
const beaconToken = analytics
  ? import.meta.env.PUBLIC_CF_BEACON_TOKEN?.trim()
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1222" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Dataceam Insights"
      href="/rss.xml"
    />
    <Seo {...seoProps} />
  </head>
  <body data-page={page}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main
      id="main"
      class={
        page === 'home' || page === 'experts'
          ? 'page-main'
          : page === 'insights' || page === 'article'
            ? 'shell insights-main'
            : 'shell prose'
      }
      tabindex="-1"
    >
      <slot />
    </main>
    <Footer />
    {beaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beaconToken })}
      />
    )}
  </body>
</html>
