---
import { getCollection } from 'astro:content';
import { frontmatter } from '../../content/home.md';
import Base from '../layouts/Base.astro';
import TrackCard from '../components/TrackCard.astro';
import TopicTile from '../components/TopicTile.astro';
import RepoCard from '../components/RepoCard.astro';
import ProviderLogo from '../components/ProviderLogo.astro';
import { isLive, sortGuides, topicLabels, type Topic } from '../lib/learning';
import { site } from '../config/site';

const tracks = await getCollection('tracks');
const guides = await getCollection('guides');
const liveGuides = guides.filter(({ data }) => isLive(data));
const latestGuides = sortGuides(
  liveGuides.length > 0
    ? liveGuides
    : [...guides].sort(
        (a, b) =>
          b.data.pubDate.getTime() - a.data.pubDate.getTime() ||
          a.id.localeCompare(b.id),
      ),
).slice(0, 5);
const repos = (await getCollection('repos', ({ data }) => isLive(data)))
  .sort(
    (a, b) =>
      b.data.stats!.fetchedAt.getTime() - a.data.stats!.fetchedAt.getTime(),
  )
  .slice(0, 3);
const firstTrack = tracks.find(({ data }) => isLive(data));
const providers = [
  ...new Map(
    tracks
      .filter(({ data }) => isLive(data))
      .flatMap(({ data }) => data.courses)
      .filter((course) => course.provider && course.logo)
      .map((course) => [
        course.provider!,
        { provider: course.provider!, logo: course.logo! },
      ]),
  ).values(),
];
const topics = Object.keys(topicLabels) as Topic[];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: new URL('/', site.url).href,
  logo: new URL('/favicon.svg', site.url).href,
  email: site.email,
  sameAs: [site.social.x, site.social.instagram],
};
---

<Base
  page="home"
  title={frontmatter.title}
  description={frontmatter.description}
  jsonLd={jsonLd}
>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="shell home-hero">
      <div class="hero-copy">
        <p class="badge">Free AI learning, plainly explained</p>
        <h1 id="hero-heading">
          Learn AI for free. Build with it. Get paid for it.
        </h1>
        <p class="lead">
          Visual guides, free course tracks and tested GitHub repos for people
          building a career in AI. When you're ready, we point you to paid
          AI-training work.
        </p>
        <div class="button-row">
          <a
            class="button button-primary"
            href={firstTrack ? `/tracks/${firstTrack.data.slug}/` : '/tracks/'}
          >
            Start a career track
          </a>
          <a class="button button-quiet" href="/guides/">
            Browse guides
          </a>
          <a class="button button-quiet" href="/repos/">
            Repos this week
          </a>
        </div>
      </div>
      <ol class="home-path" aria-label="Learn, Build, Earn">
        <li>
          <h2>Learn</h2>
          <p>Guides and free course tracks</p>
        </li>
        <li>
          <h2>Build</h2>
          <p>Open-source repos we've run ourselves</p>
        </li>
        <li class="home-earn">
          <h2>Earn</h2>
          <p>Paid AI-training work</p>
        </li>
      </ol>
    </div>
  </section>
  <section class="band" aria-labelledby="career-tracks">
    <div class="shell stack">
      <div class="section-head">
        <p class="kicker">Career tracks</p>
        <h2 id="career-tracks">Free courses, in the right order</h2>
        <p>
          Each track lists free courses from the companies that make the tools,
          from first steps to advanced, with hours and a weekly plan. Where an
          exam exists, it's optional.
        </p>
      </div>
      <div class="learning-grid">
        {tracks.map((track) => (
          <TrackCard track={track} linkSoon={false} />
        ))}
      </div>
      {providers.length > 0 && (
        <div class="home-providers">
          <p>Courses from</p>
          {providers.map((provider) => (
            <ProviderLogo {...provider} />
          ))}
        </div>
      )}
    </div>
  </section>
  <section class="band" aria-labelledby="guides-heading">
    <div class="shell stack">
      <div class="section-head">
        <p class="kicker">Guides</p>
        <h2 id="guides-heading">One idea, one picture</h2>
        <p>
          Plain-English explainers of how AI actually works, each with pictures,
          examples and its sources.
        </p>
      </div>
      <p>
        <a href="/guides/">All {guides.length} guides</a>
      </p>
      <ul class="learning-grid" aria-label="Guide topics">
        {topics.map((topic) => (
          <TopicTile
            topic={topic}
            count={guides.filter(({ data }) => data.topic === topic).length}
            liveCount={
              liveGuides.filter(({ data }) => data.topic === topic).length
            }
          />
        ))}
      </ul>
      <h3>Latest guides</h3>
      {latestGuides.length > 0 ? (
        <ul class="home-latest">
          {latestGuides.map(({ id, data }) => (
            <li>
              <a href={`/guides/${id}/`}>
                <span>{data.title}</span>
                <span class="hint">{topicLabels[data.topic].label}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="hint">Coming soon</p>
      )}
    </div>
  </section>
  <section class="band" aria-labelledby="repos-heading">
    <div class="shell stack">
      <div class="section-head">
        <h2 id="repos-heading">Repos worth your time this week</h2>
        <p>
          We pick open-source repos, run the quickstart ourselves, and write
          down what it needs and where it breaks.
        </p>
      </div>
      {repos.length > 0 ? (
        <div class="learning-grid">
          {repos.map((repo) => (
            <RepoCard repo={repo} />
          ))}
        </div>
      ) : (
        <p>
          Coming soon. We're running the first quickstarts ourselves before we
          publish them. <a href="/repos/">See what's coming</a>
        </p>
      )}
    </div>
  </section>
  <section class="band" aria-labelledby="jobs-heading">
    <div class="shell">
      <div class="crosslink learning-next">
        <div class="stack">
          <p class="kicker">AI jobs</p>
          <h2 id="jobs-heading">Ready to get paid for AI work?</h2>
          <p>
            AI companies pay engineers, analysts and subject experts to train
            and test their models. We list the platforms we refer people to,
            with typical pay from public listings.
          </p>
          <p class="hint">
            Referral links: we may earn a fee if you join through them.{' '}
            <a href="/disclosure/">Referral disclosure</a>
          </p>
        </div>
        <a class="button button-primary" href="/jobs/">
          See AI-training work
        </a>
      </div>
    </div>
  </section>
  <section class="band" aria-labelledby="newsletter-heading">
    <div class="shell">
      <div class="insight-card learning-card">
        <span class="badge learning-chip learning-soon">Coming soon</span>
        <h2 id="newsletter-heading">Newsletter: coming soon</h2>
        <p>
          One short email with new guides, career tracks and repos. Sign-up
          isn't open yet.
        </p>
      </div>
    </div>
  </section>
  <section
    id="contact"
    class="band"
    aria-labelledby="companies-heading"
    tabindex="-1"
  >
    <div class="shell crosslink">
      <div class="stack">
        <h2 class="hint" id="companies-heading">
          For companies
        </h2>
        <p>Your company's records may be worth money to an AI lab.</p>
      </div>
      <a class="button button-quiet" href="/companies/">
        See how data licensing works
      </a>
    </div>
  </section>
</Base>

<style>
  .home-latest a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 40%);
    column-gap: 1rem;
  }
  .home-latest .hint {
    text-align: right;
  }
</style>
