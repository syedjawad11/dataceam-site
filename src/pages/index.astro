---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';

const title = 'Dataceam — Could your company’s records be licensed for AI?';
const description =
  'Dataceam helps businesses in the US and Canada explore AI licensing opportunities for the records they already own. No charge to your business for an introduction.';
const examples = [
  {
    category: 'Software and engineering',
    examples: 'Bug reports, test cases, technical guides',
    detail:
      'A bug report becomes more useful when it connects the original problem to the fix and the test that confirmed it worked. A history of those decisions shows how your engineers solve problems.',
  },
  {
    category: 'Operations and logistics',
    examples: 'Inspection records, production procedures, exception reports',
    detail:
      'A delivery exception log might show what went wrong, which options a dispatcher considered and how the shipment was recovered. Those details capture decisions that a standard procedure can miss.',
  },
  {
    category: 'Support and troubleshooting',
    examples: 'Knowledge articles, repair guides, resolved issues',
    detail:
      'A troubleshooting history can connect a reported fault to the checks a technician ran and the repair that worked. That sequence shows how an experienced team moves from symptoms to a solution.',
  },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  description,
  url: site.url,
  logo: new URL('/favicon.svg', site.url).href,
};
---

<Base page="home" title={title} description={description} jsonLd={jsonLd}>
  <section class="home-section home-hero" aria-labelledby="hero-heading">
    <div class="shell home-inner home-stack">
      <h1 id="hero-heading">
        Could your company’s records be licensed for AI?
      </h1>
      <p class="home-lead">
        The guides your team writes, the problems it solves and the processes it
        documents can be useful to AI developers. Dataceam helps businesses in
        the US and Canada explore licensing opportunities for records they
        already own.
      </p>
      <p>
        A licensing agreement can create a new source of revenue from work your
        team has already done.
      </p>
      <a class="button button-primary" href="#examples">
        Explore data examples
      </a>
    </div>
  </section>
  <section
    id="examples"
    class="home-section"
    aria-labelledby="examples-heading"
  >
    <div class="shell home-inner home-stack">
      <h2 id="examples-heading">What does your team already document?</h2>
      <p>
        You may recognize some of these records in your own business. Select a
        category to see an example.
      </p>
      <div class="home-examples">
        {examples.map(({ category, examples, detail }, index) => (
          <details open={index === 0}>
            <summary>
              <span class="example-summary">
                <span class="example-category">{category}</span>
                <span>{examples}</span>
              </span>
              <svg
                class="example-chevron"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
                focusable="false"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <p class="example-detail">{detail}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <section class="home-section home-value" aria-labelledby="value-heading">
    <div class="shell home-inner home-stack">
      <hr />
      <h2 id="value-heading">What could a licensing agreement be worth?</h2>
      <p>
        One example is micro1, an AI data licensing program. It lists{' '}
        <strong>US$100,000–$500,000</strong> for qualifying enterprise data
        partnerships and <strong>US$3 million or more</strong> for exceptionally
        distinctive datasets. The buyer evaluates each opportunity and sets any
        offer based on the records’ quality, scale and usefulness.
      </p>
      <a
        href="https://www.micro1.ai/data-partnerships"
        rel="noopener"
        target="_blank"
      >
        See micro1’s published ranges
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>
  </section>
  <section
    id="how-it-works"
    class="home-section home-role"
    aria-labelledby="role-heading"
  >
    <div class="shell home-inner home-stack">
      <h2 id="role-heading">From a first question to a buyer conversation</h2>
      <p>
        Tell us what your company does and what kinds of records your team has
        built up. If a licensing program looks relevant, we’ll explain what the
        buyer is looking for and how to get in touch. You decide whether to take
        the next step. From there, you and the buyer discuss the records, the
        terms and any payment directly.
      </p>
      <p>
        There’s no charge to your business for an introduction. Dataceam may
        earn a referral fee from the program if a deal goes ahead and qualifies.
      </p>
    </div>
  </section>
  <section
    id="contact"
    class="home-section home-contact"
    aria-labelledby="contact-heading"
    tabindex="-1"
  >
    <div class="shell home-inner home-stack">
      <h2 id="contact-heading">Have a particular set of records in mind?</h2>
      <p>
        A couple of sentences about your business and the records you have are
        enough to start.
      </p>
      <a class="button button-primary" href="/#contact" data-email-dialog-open>
        Get in touch
      </a>
    </div>
  </section>
</Base>
