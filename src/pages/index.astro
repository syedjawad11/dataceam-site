---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.url}/#organization`,
      name: site.name,
      url: site.url,
    },
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: site.personName,
    },
  ],
};
---

<Base title="Dataceam" description="Dataceam. Hello world." jsonLd={jsonLd}>
  <h1>Dataceam</h1>
  <p>Hello world.</p>
</Base>
