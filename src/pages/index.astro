---
import Base from '../layouts/Base.astro';
import EmailCta from '../components/EmailCta.astro';
import { site } from '../config/site';

const title =
  "Dataceam — What your company's records could be worth to AI developers";
const description =
  'Dataceam connects companies that hold years of business records with vetted AI data buyers who review, clean and license them. Free to you.';
const tools = [
  'Slack',
  'GitHub',
  'Salesforce',
  'Zendesk',
  'Google Drive',
  'QuickBooks',
  'Jira',
  'Notion',
  'HubSpot',
];
const dataCards = [
  [
    'Conversations',
    'Team threads and email where work gets agreed, with the reasoning along the way',
    'Slack, Microsoft Teams, Gmail, Outlook',
  ],
  [
    'Code and engineering',
    'Repositories with their history, pull requests, bug tracking and technical docs',
    'GitHub, GitLab, Bitbucket, Linear',
  ],
  [
    'Documents and files',
    'Contracts, reports, SOPs, policies, decks and knowledge bases',
    'Google Drive, SharePoint, Notion, Dropbox',
  ],
  [
    'Sales and CRM',
    'Deals, pipelines, playbooks and the customer lifecycle',
    'Salesforce, HubSpot',
  ],
  [
    'Finance and accounting',
    'Invoices, ledgers, reconciliations, approvals and reporting workflows',
    'QuickBooks, NetSuite',
  ],
  [
    'Support and tickets',
    'Each request from first message to resolution, with every step in between',
    'Zendesk, Jira, ServiceNow',
  ],
  [
    'Operations and logistics',
    'Fulfilment, inventory, orders and internal process docs',
    'ERP and order systems',
  ],
  [
    'Legal and compliance',
    'Contract review, governance and compliance procedures',
    'Document and contract tools',
  ],
];
const steps = [
  [
    'A free review by email.',
    'Tell us which tools you use, how many years of records you hold and roughly how big your team is. No data changes hands.',
  ],
  [
    'An introduction to the right buyer.',
    'We match you with a vetted AI data buyer whose requirements fit your company, and introduce you directly.',
  ],
  [
    'The buyer reviews, cleans and packages your data.',
    'They connect read-only to the sources you approve, strip out names, contact details and other identifiers, and package the data so AI labs can judge its quality. You get an offer before you commit to anything.',
  ],
  [
    'You approve, sign and get paid.',
    'Nothing is licensed without your written sign-off. Once a deal closes, the buyer pays you directly.',
  ],
];
const pricing = [
  [
    'Starter',
    '$50K – $500K',
    'A focused set of records from one or two systems, often a 20–50 person company',
  ],
  [
    'Established',
    '$500K – $3M',
    'Years of records across several teams and business functions',
  ],
  [
    'Exceptional',
    '$3M+',
    'Rare, proprietary operational data of high value to frontier AI',
  ],
];
const protections = [
  [
    'You choose the sources.',
    'You approve every system and dataset, and sign the terms first.',
  ],
  [
    'Read-only, encrypted access.',
    'Buyers copy data; they never change anything in your tools.',
  ],
  [
    'Personal details removed.',
    'Names, emails, customer details and account numbers are stripped before data leaves processing.',
  ],
  [
    'Nothing released unpaid.',
    'Buyers see redacted samples only until a deal is paid.',
  ],
  [
    'Never sold to competitors.',
    'Data is licensed to AI labs and research teams under contract, and never published.',
  ],
  [
    'Kept separate, then deleted.',
    "Your data is stored apart from other companies' data, and raw copies are deleted on an agreed schedule.",
  ],
];
const criteria = [
  ['Team size:', '20+ staff is ideal; some buyers accept teams from 10.'],
  [
    'History:',
    'several years of records, ideally 5+, spread across more than one system.',
  ],
  [
    'Language:',
    'mainly English, though some buyers accept other European languages.',
  ],
  [
    'Ownership:',
    'the data is yours to license, not held for clients under contract.',
  ],
  [
    'Strong sectors:',
    'software and IT services, agencies, logistics, manufacturing, wholesale and B2B services.',
  ],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  logo: new URL('/favicon.svg', site.url).href,
  sameAs: [`https://x.com/${site.xHandle.replace(/^@/, '')}`],
};
---

<Base page="home" title={title} description={description} jsonLd={jsonLd}>
  <section class="home-section home-hero" aria-labelledby="hero-heading">
    <div class="shell home-hero-grid">
      <div class="home-stack">
        <h1 id="hero-heading">
          Could your company's records be licensed for AI?
        </h1>
        <p class="home-hero-answer">
          Yes, and they can earn your company new revenue.
        </p>
        <p class="home-hero-amount">
          Depending on the data, a licensing deal may be worth{' '}
          <strong>$50K to $3M+</strong>.
        </p>
        <p class="home-lead">
          AI labs have run out of public internet to learn from. What they need
          now is the record of how real businesses work. Dataceam connects
          companies that hold that data with vetted buyers who review it, clean
          it and license it.
        </p>
        <EmailCta label="See what your data could be worth" href="#contact" />
        <p>Free to you. You keep your data, your business and the final say.</p>
      </div>
      <div class="home-mosaic" aria-hidden="true">
        {tools.map((tool) => (
          <div class="home-mosaic-tile">{tool}</div>
        ))}
      </div>
    </div>
  </section>
  <section class="home-section" aria-labelledby="why-value">
    <div class="shell home-split">
      <div class="home-section-heading">
        <p class="home-eyebrow">Why your data has value</p>
        <h2 id="why-value">The trail is what's worth paying for</h2>
      </div>
      <div class="home-stack">
        <p>
          Every ticket closed, deal logged and decision made in a thread leaves
          a record: what was asked, the steps someone took, what they checked,
          and how it ended. Your tools have been keeping that trail for years.
        </p>
        <p>
          AI developers turn those records into worked examples. A model studies
          thousands of them, practises the same tasks, and is then tested on
          real work it has never seen. That kind of data doesn't exist on the
          public web, which is why buyers pay for it.
        </p>
        <p>
          You're selling a licensed, cleaned copy. Your original data stays
          where it is, and nothing about how you work changes.
        </p>
      </div>
    </div>
  </section>
  <section class="home-section" aria-labelledby="data-kinds">
    <div class="shell home-stack">
      <div class="home-section-heading">
        <p class="home-eyebrow">What kinds of data qualify</p>
        <h2 id="data-kinds">
          Data from almost every part of a business can count
        </h2>
      </div>
      <p class="home-intro">
        If your team has worked in the same tools for years, you likely already
        hold what buyers look for.
      </p>
      <div class="home-grid home-data-grid">
        {dataCards.map(([title, coverage, sources]) => (
          <article class="home-card home-data-card">
            <span class="home-card-mark" aria-hidden="true">
              {title.slice(0, 1)}
            </span>
            <h3>{title}</h3>
            <p>{coverage}</p>
            <div class="home-sources">
              <p>Typical sources</p>
              <ul class="data-pills" role="list">
                {sources.split(', ').map((source, index, all) => (
                  <li>
                    {source}
                    {index < all.length - 1 && <span class="sr-only">,</span>}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
      <p class="home-callout">
        <strong>It doesn't have to be a company that's still trading.</strong>{' '}
        Records from a business that has shut down, closed, gone bankrupt or
        been liquidated can also qualify, as long as they meet the buyer's
        criteria and data-protection rules such as GDPR. In a bankruptcy or
        liquidation, the trustee or liquidator usually needs to approve the
        deal. These archives are often available for a limited time before the
        software accounts are shut down.
      </p>
    </div>
  </section>
  <section class="home-section" aria-labelledby="how-it-works">
    <div class="shell home-stack">
      <div class="home-section-heading">
        <p class="home-eyebrow">How it works</p>
        <h2 id="how-it-works">From first email to payment, in four steps</h2>
      </div>
      <ol class="home-grid home-steps" role="list">
        {steps.map(([title, text]) => (
          <li class="home-card">
            <strong>{title}</strong> {text}
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section class="home-section" aria-labelledby="data-worth">
    <div class="shell home-stack">
      <div class="home-section-heading">
        <p class="home-eyebrow">What it could be worth</p>
        <h2 id="data-worth">Payouts range from $50K to $3M+</h2>
      </div>
      <p class="home-intro">
        Buyers price data on its quality, how unique it is, and how much of it
        there is.
      </p>
      <div class="home-grid home-pricing">
        {pricing.map(([name, range, profile]) => (
          <article
            class:list={[
              'home-card',
              { 'home-price-featured': name === 'Established' },
            ]}
          >
            <h3>{name}</h3>
            <p class="home-price">{range}</p>
            <p>{profile}</p>
          </article>
        ))}
      </div>
      <p class="home-price-note">
        These are typical ranges from current buyers, not a guarantee. The final
        figure depends on your data and is agreed with the buyer before you
        sign.
      </p>
    </div>
  </section>
  <section class="home-section" aria-labelledby="privacy-control">
    <div class="shell home-stack">
      <div class="home-section-heading">
        <p class="home-eyebrow">Privacy and control</p>
        <h2 id="privacy-control">
          You decide what goes, and it's all in writing
        </h2>
      </div>
      <p class="home-intro">
        We only introduce companies to buyers who commit to the protections
        below. Each one is confirmed in your contract before anything is shared.
      </p>
      <ul class="home-grid home-protections" role="list">
        {protections.map(([title, text]) => (
          <li class="home-card">
            <svg
              class="home-card-mark"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M12 3 4 6v6c0 4 5 8 8 9 3-1 8-5 8-9V6l-8-3Z" />
              <path d="m8 12 3 3 5-6" />
            </svg>
            <p>
              <strong>{title}</strong> {text}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="home-section" aria-labelledby="who-qualifies">
    <div class="shell home-split">
      <div class="home-section-heading">
        <p class="home-eyebrow">Who qualifies</p>
        <h2 id="who-qualifies">A good fit usually looks like this</h2>
      </div>
      <div class="home-stack">
        <ul class="home-grid home-criteria" role="list">
          {criteria.map(([label, text]) => (
            <li class="home-card">
              <strong>{label}</strong> {text}
            </li>
          ))}
        </ul>
        <p>
          Not sure? <a href="#contact">Send us a short email</a> and we'll tell
          you.
        </p>
      </div>
    </div>
  </section>
  <section class="home-section" aria-labelledby="about-dataceam">
    <div class="shell home-split">
      <div class="home-section-heading">
        <p class="home-eyebrow">About Dataceam</p>
        <h2 id="about-dataceam">An independent scout, not a data broker</h2>
      </div>
      <div class="home-stack">
        <p>
          We at Dataceam help companies find value in data they're already
          sitting on. We research AI data buyers, check their terms, and only
          introduce you to buyers we've vetted. We're independent and don't
          represent any single buyer, so we can point you to whichever one fits
          your company best.
        </p>
        <p class="home-callout">
          <strong>How we're paid:</strong> The buyer pays us a referral fee when
          a deal closes. You pay nothing for our help.
        </p>
      </div>
    </div>
  </section>
  <section
    id="contact"
    class="home-section home-contact"
    aria-labelledby="contact-heading"
    tabindex="-1"
  >
    <div class="shell home-inner home-stack">
      <h2 id="contact-heading">Find out what your data is worth</h2>
      <p class="home-lead">
        Email us a few lines about your company. We'll reply with whether your
        company qualifies, which buyers fit, and roughly what range to expect.
        No commitment, and no data shared.
      </p>
      <EmailCta label="Email us" noteId="contact-email-note" prominent />
    </div>
  </section>
</Base>
